{
  "name": "eslint-plugin-next-route-params",
  "version": "0.1.0",
  "description": "eslint rule to enforce correct route parameters for Next.js",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "eslint src && prettier src --check",
    "lint:fix": "eslint --fix src && prettier src --write",
    "typecheck": "tsc --noEmit",
    "update:eslint-docs": "eslint-doc-generator"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "nextjs",
    "route",
    "params",
    "filebased",
    "approuter"
  ],
  "author": "Paul Heisner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mando-C137/next-routeparams.git"
  },
  "license": "MIT",
  "dependencies": {
    "@typescript-eslint/utils": "^8.59.0",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/rule-tester": "^8.59.0",
    "@typescript-eslint/types": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-doc-generator": "^3.3.2",
    "eslint-plugin-eslint-plugin": "^7.3.2",
    "prettier": "^3.8.3",
    "tsdown": "^0.21.10",
    "type-fest": "^5.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": ">=8.5.0",
    "eslint": ">=8.57.0",
    "typescript": ">=5"
  },
  "files": [
    "dist"
  ]
}
